# LANDScope Example Environment Configuration
# Copy this file to .env.local and populate with your own keys

# MapTiler Cloud API Key (Get your free key from https://cloud.maptiler.com/account/keys/)
NEXT_PUBLIC_MAPTILER_KEY=YOUR_MAPTILER_KEY_HERE

# Supabase Project Configuration (Publishable/Anon Client Safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key
